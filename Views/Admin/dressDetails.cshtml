@model List<Dress>

@{
    ViewData["Title"] = "Dress Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <h2 class="text-center mb-5">
        Dress Details
    </h2>

    @foreach (var pro in Model)
    {
        <div class="row justify-content-center">

            <!-- IMAGE -->
            <div class="col-md-5">

                <div class="card shadow-sm border-0 p-3">

                    <img src="@Url.Content("~/dress_image/" + pro.dress_image)"
                         asp-append-version="true"
                         class="img-fluid rounded"
                         alt="@pro.dress_name"
                         style="width:100%; height:420px; object-fit:contain;" />

                </div>

            </div>


            <!-- DETAILS -->
            <div class="col-md-5">

                <div class="card shadow-sm border-0 p-4 h-100">

                    <h2>
                        @pro.dress_name
                    </h2>

                    <h4 class="text-primary mt-3">
                        ৳ @pro.dress_price
                    </h4>

                    <p class="mt-4">
                        <strong>Description:</strong>
                    </p>

                    <p>
                        @pro.dress_description
                    </p>

                    <p>
                        <strong>Category:</strong>

                        @if (pro.Category != null)
                        {
                            @pro.Category.category_name
                        }
                        else
                        {
                            <span>Not Available</span>
                        }
                    </p>


                    <!-- BUTTONS -->
                    <div class="mt-4">

                        <!-- ADD TO CART -->
                        <a href="@Url.Action("AddToCart", "Customer", new { dress_id = pro.dress_id })"
                           class="btn btn-warning me-2">

                            <i class="fas fa-shopping-cart"></i>
                            Add To Cart

                        </a>


                        <!-- BUY NOW -->
                        <a href="@Url.Action("BuyNow", "Customer", new { dress_id = pro.dress_id })"
                           class="btn btn-primary me-2">

                            <i class="fas fa-credit-card"></i>
                            Buy Now

                        </a>


                        <!-- WISHLIST -->
                        <a href="@Url.Action("AddToWishlist", "Customer", new { dress_id = pro.dress_id })"
                           class="btn btn-danger">

                            <i class="fas fa-heart"></i>
                            Wishlist

                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>