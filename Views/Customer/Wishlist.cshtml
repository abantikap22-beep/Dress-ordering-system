@model List<Wishlist>

@{
    ViewData["Title"] = "My Wishlist";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <h2 class="text-center mb-5">
        ❤️ My Wishlist
    </h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center">

            <div style="font-size:60px;">
                💔
            </div>

            <h4>Your wishlist is empty</h4>

            <p class="text-muted">
                Add your favorite products to your wishlist.
            </p>

            <a href="@Url.Action("fetchAllDress", "Customer")"
               class="btn btn-primary">

                Browse Products

            </a>

        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-6 mb-4">

                    <div class="card h-100 shadow-sm">

                        <img src="@Url.Content("~/dress_image/" + item.Dress.dress_image)"
                             class="card-img-top"
                             style="height:280px; object-fit:cover;"
                             alt="@item.Dress.dress_name" />

                        <div class="card-body text-center">

                            <h5 class="card-title">
                                @item.Dress.dress_name
                            </h5>

                            <h6 class="text-primary">
                                ৳ @item.Dress.dress_price
                            </h6>

                            <a href="@Url.Action("DressDetails", "Customer", new { id = item.Dress.dress_id })"
                               class="btn btn-dark mt-2">

                                View Product

                            </a>

                            <a href="@Url.Action("RemoveFromWishlist", "Customer", new { id = item.wishlist_id })"
                               class="btn btn-outline-danger mt-2 ">

                                Remove

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>