@model List<Dress>

@{
    ViewData["Title"] = "Dress Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">

    <h2 class="text-center mb-5">
        Dress Details
    </h2>

    @foreach (var pro in Model)
    {
        <div class="row">

            <!-- IMAGE -->
            <div class="col-md-6 text-center">

                <img src="~/dress_image/@pro.dress_image"
                     asp-append-version="true"
                     class="img-fluid rounded shadow"
                     style="width:100%; max-width:500px; height:450px; object-fit:cover;" />

            </div>


            <!-- DETAILS -->
            <div class="col-md-6">

                <h2>
                    @pro.dress_name
                </h2>

                <h3 class="mt-3">
                    ৳ @pro.dress_price
                </h3>

                <hr />

                <h5>
                    Description
                </h5>

                <p>
                    @pro.dress_description
                </p>

                <p class="mt-3">
                    <strong>
                        Available Quantity:
                    </strong>

                    @pro.dress_quantity
                </p>


                @if (pro.dress_quantity > 0)
                {
                    <p class="text-success">
                        In Stock
                    </p>
                }
                else
                {
                    <p class="text-danger">
                        Out of Stock
                    </p>
                }


                <!-- BUTTONS -->
                @if (pro.dress_quantity > 0)
                {
                    <div class="mt-4">

                        <a href="@Url.Action(
                                                       "AddToCart",
                                                       "Customer",
                                                       new { dress_id = pro.dress_id })"
                   class="btn btn-warning me-2">

                            🛒 Add To Cart

                        </a>


                        <a href="@Url.Action(
                                               "BuyNow",
                                               "Customer",
                                               new { dress_id = pro.dress_id })"
                   class="btn btn-primary">

                            💳 Buy Now

                        </a>

                    </div>
                        }
                else
                {
                    <button class="btn btn-secondary" disabled>
                        Out of Stock
                    </button>
                }

            </div>

        </div>
    }

</div>